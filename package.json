    "eg-walker",
    "collaboration",
    "shared-editing"
  ],
  "homepage": "https://github.com/waka/crdt-eg-walker#readme",
  "bugs": {
    "url": "https://github.com/waka/crdt-eg-walker/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waka/crdt-eg-walker.git"
  },
  "license": "MIT",
  "author": "yo_waka",
